# Banco (Railway preenche sozinho quando o MySQL esta ligado ao servico)
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLDATABASE=receitas
MYSQLUSER=root
MYSQLPASSWORD=root

# Front autorizado a chamar a API (separe por virgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://seu-front.vercel.app

# Assinatura do JWT - troque em producao
JWT_SECRET=troque-este-segredo-em-producao-0123456789abcdef

# Primeiro administrador, criado na subida da aplicacao
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@senai.br
ADMIN_PASSWORD=troque-esta-senha

# Supabase Storage (bucket PUBLICO)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=cole-aqui-a-service-role-key
SUPABASE_BUCKET=receitas
